# ---- Supabase (Project Settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. Never expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# ---- Site ----
# Local: http://localhost:3000   Production: https://lancenest.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Stripe (Phase 8 — not wired up yet, placeholders only) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Development seed accounts (scripts/seed-users.mjs) ----
# Choose your own strong password (12+ chars). Used only for local demo accounts.
DEMO_PASSWORD=

# ---- Cloudflare Turnstile bot check (public site key; secret goes in Supabase -> Auth -> Attack Protection) ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
